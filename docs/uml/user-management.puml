' user-management 模块：账号、会话、权限、审计与密码重置
package "user-management | 账号与权限" as P_USER {
    interface U_UserManagementService as "UserManagementService" {
        + register(credentials): ServiceResult<Void>
        + listAccounts(token): ServiceResult<List<UserAccountSummary>>
        + importUsers(token, rows): ServiceResult<UserImportResult>
        + setAccountActive(command): ServiceResult<Void>
        + changeUserRole(command): ServiceResult<Void>
        + listAuditEvents(token): ServiceResult<List<AuditEvent>>
        + requestPasswordReset(command): ServiceResult<Void>
        + reviewPasswordReset(command): ServiceResult<PasswordResetReviewResult>
        + login(credentials): ServiceResult<Session>
        + currentSession(token): ServiceResult<Session>
        + logout(token): ServiceResult<Void>
        + authorize(token, permission): ServiceResult<Boolean>
    }
    class U_DefaultUserManagementService as "DefaultUserManagementService" {
        - users: UserRepository
        - sessions: SessionManager
        - auditLog: AuditLogRepository
        - passwordResets: PasswordResetApplicationRepository
        - profileBindings: ProfileBindingRepository
        - passwordHasher: PasswordHasher
        - permissionPolicy: RolePermissionPolicy
        + register / login / logout / authorize
        + import / account status / role change
        + password reset workflow
    }
    class U_InMemoryUserManagementService as "InMemoryUserManagementService" {
        - delegate: UserManagementService
    }
    interface U_UserRepository as "UserRepository" {
        + create(account): boolean
        + findById(userId): UserAccount
        + findAll(): List<UserAccount>
        + setActive(userId, active): boolean
        + changeRole(userId, role): boolean
        + updatePasswordHash(userId, hash, force): boolean
    }
    interface U_AuditLogRepository as "AuditLogRepository" {
        + record(event): void
        + findAll(): List<AuditEvent>
    }
    interface U_ProfileBindingRepository as "ProfileBindingRepository" {
        + validate(role, profileId, userId): ProfileBindingResult
        + bind(role, profileId, userId): ProfileBindingResult
        + findProfileId(role, userId): String
    }
    interface U_PasswordResetRepository as "PasswordResetApplicationRepository" {
        + save(application): void
        + findPendingByUserId(userId): PasswordResetApplication
        + findPending(): List<PasswordResetApplication>
        + review(userId, status, reviewer, time): boolean
    }
    class U_InMemoryUserRepository as "InMemoryUserRepository"
    class U_InMemoryAuditLogRepository as "InMemoryAuditLogRepository"
    class U_InMemoryProfileBindingRepository as "InMemoryProfileBindingRepository"
    class U_NoOpProfileBindingRepository as "NoOpProfileBindingRepository"
    class U_InMemoryPasswordResetRepository as "InMemoryPasswordResetApplicationRepository"
    class U_SessionManager as "SessionManager" {
        - sessions: Map<String, Session>
        - activeTokensByUserId: Map<String, String>
        + create(user): Session
        + find(token): Session
        + invalidate(token): boolean
        + invalidateUser(userId): void
    }
    class U_Session as "Session" {
        - token: String
        - user: User
        - forcePasswordChange: boolean
    }
    class U_UserAccount as "UserAccount" {
        - user: User
        - passwordHash: String
        - active: boolean
        - forcePasswordChange: boolean
        - createdBy: String
        - createdAt: Instant
        - importBatchId: String
    }
    class U_PasswordHasher as "PasswordHasher" {
        + hash(password): String
        + matches(password, encoded): boolean
    }
    class U_RolePermissionPolicy as "RolePermissionPolicy" {
        - matrix: Map<Role, Set<Permission>>
        + isAllowed(role, permission): boolean
    }
    enum U_Permission as "Permission" {
        USER_SELF_READ / USER_MANAGE
        STUDENT_READ / STUDENT_WRITE
        COURSE_READ / COURSE_SELECT / COURSE_MANAGE
        GRADE_WRITE / ACADEMIC_REVIEW
        LIBRARY_READ / LIBRARY_BORROW / LIBRARY_MANAGE
        STORE_READ / STORE_PURCHASE / STORE_MANAGE
    }
    class U_UserCredentials as "UserCredentials" {
        - userId: String
        - password: String
        - displayName: String
        - roleCode: String
        - profileId: String
    }
    class U_UserRegistrationCommand as "UserRegistrationCommand" {
        - token: String
        - credentials: UserCredentials
    }
    class U_UserCommand as "UserCommand" {
        - token: String
        - userId: String
    }
    class U_UserStatusCommand as "UserStatusCommand"
    class U_UserRoleChangeCommand as "UserRoleChangeCommand"
    class U_UserImportCommand as "UserImportCommand"
    class U_UserImportRow as "UserImportRow"
    class U_UserImportResult as "UserImportResult"
    class U_UserAccountSummary as "UserAccountSummary"
    class U_AuditEvent as "AuditEvent"
    class U_AuthorizationRequest as "AuthorizationRequest"
    class U_PasswordResetApplication as "PasswordResetApplication"
    class U_PasswordResetRequestCommand as "PasswordResetRequestCommand"
    class U_PasswordResetReviewCommand as "PasswordResetReviewCommand"
    class U_PasswordResetReviewResult as "PasswordResetReviewResult"
    class U_PasswordResetApplicationSummary as "PasswordResetApplicationSummary"
    class U_PasswordChangeCommand as "PasswordChangeCommand"
    enum U_PasswordResetStatus as "PasswordResetStatus"
    enum U_ProfileBindingResult as "ProfileBindingResult"

    U_UserManagementService <|.. U_DefaultUserManagementService
    U_UserManagementService <|.. U_InMemoryUserManagementService
    U_InMemoryUserManagementService --> U_DefaultUserManagementService : delegates
    U_DefaultUserManagementService --> U_UserRepository
    U_DefaultUserManagementService --> U_AuditLogRepository
    U_DefaultUserManagementService --> U_ProfileBindingRepository
    U_DefaultUserManagementService --> U_PasswordResetRepository
    U_DefaultUserManagementService *-- U_SessionManager
    U_DefaultUserManagementService *-- U_PasswordHasher
    U_DefaultUserManagementService *-- U_RolePermissionPolicy
    U_UserRepository <|.. U_InMemoryUserRepository
    U_AuditLogRepository <|.. U_InMemoryAuditLogRepository
    U_ProfileBindingRepository <|.. U_InMemoryProfileBindingRepository
    U_ProfileBindingRepository <|.. U_NoOpProfileBindingRepository
    U_PasswordResetRepository <|.. U_InMemoryPasswordResetRepository
    U_SessionManager o-- U_Session
    U_UserAccount --> C_User
    U_Session --> C_User
    U_RolePermissionPolicy ..> U_Permission
    U_PasswordResetApplication --> U_PasswordResetStatus
    U_UserRegistrationCommand --> U_UserCredentials
    U_UserImportCommand o-- U_UserImportRow
}
