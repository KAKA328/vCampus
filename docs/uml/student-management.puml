' student-management 模块：学籍档案与学业审查模型
package "student-management | 学籍与学业审查" as P_STUDENT {
    interface STU_StudentManagementService as "StudentManagementService" {
        + findById(studentId): ServiceResult<StudentRecord>
        + findByClass(classId): ServiceResult<List<StudentRecord>>
        + save(record): ServiceResult<StudentRecord>
    }
    class STU_StudentRecord as "StudentRecord" {
        - studentId: String
        - name: String
        - gender: String
        - departmentName: String
        - majorName: String
        - classId: String
        - enrollmentYear: int
        - status: String
        - phone/email: String
    }
    class STU_CourseHistoryRecord as "CourseHistoryRecord" {
        - studentId/courseId: String
        - courseName/semester: String
        - attemptNo: int
        - score/earnedCredits: int
        - attemptType: String
        - passed: boolean
    }
    class STU_AcademicReview as "AcademicReview" {
        - studentId: String
        - totalEarnedCredits: int
        - passedCourseCount: int
        - failedCourseCount: int
        - retakeCourseCount: int
        - graduationReady: boolean
        - remark: String
    }
    class STU_AcademicReviewService as "InMemoryAcademicReviewService" {
        - historiesByStudentId: Map<String, List<CourseHistoryRecord>>
        + addHistory(record): ServiceResult<Void>
        + historyFor(studentId): ServiceResult<List<CourseHistoryRecord>>
        + review(studentId, requiredCredits): ServiceResult<AcademicReview>
    }
    STU_AcademicReviewService o-- STU_CourseHistoryRecord
    STU_AcademicReviewService ..> STU_AcademicReview : computes
}
