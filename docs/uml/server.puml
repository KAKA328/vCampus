' server 模块：Socket 入口、消息处理器、工厂与 Access 适配器
package "server | Socket 服务与持久化适配" as P_SERVER {
    class S_ServerApplication as "ServerApplication" {
        - port: int
        - userMessages: UserMessageHandler
        - courseMessages: CourseMessageHandler
        - storeMessages: StoreMessageHandler
        - clients: ExecutorService
        + start(): void
        + close(): void
        ~ dispatch(request): Message
    }
    class S_ClientHandler as "ClientHandler" {
        - socket: Socket
        + run(): void
    }
    class S_UserMessageHandler as "UserMessageHandler" {
        - service: UserManagementService
        + handle(request): Message
    }
    class S_CourseMessageHandler as "CourseMessageHandler" {
        - courses: CourseSelectionService
        - catalog: CourseCatalogService
        - offerings: CourseOfferingService
        - profiles: StudentSelectionProfileProvider
        - users: UserManagementService
        + handle(request): Message
    }
    class S_StoreMessageHandler as "StoreMessageHandler" {
        - store: StoreService
        - users: UserManagementService
        + handle(request): Message
    }
    class S_UserServiceFactory as "UserServiceFactory"
    class S_StoreServiceFactory as "StoreServiceFactory"
    class S_AccessUserRepository as "AccessUserRepository"
    class S_AccessAuditLogRepository as "AccessAuditLogRepository"
    class S_AccessPasswordResetRepository as "AccessPasswordResetApplicationRepository"
    class S_AccessProfileBindingRepository as "AccessProfileBindingRepository"
    class S_AccessProductRepository as "AccessProductRepository"
    class S_AccessOrderRepository as "AccessOrderRepository"

    S_ServerApplication *-- S_ClientHandler
    S_ServerApplication *-- S_UserMessageHandler
    S_ServerApplication *-- S_CourseMessageHandler
    S_ServerApplication *-- S_StoreMessageHandler
    S_ServerApplication ..> S_UserServiceFactory
    S_ServerApplication ..> S_StoreServiceFactory
}
