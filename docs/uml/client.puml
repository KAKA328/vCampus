' client 模块：Swing 界面、远程服务适配与 Socket 传输
package "client | Swing 桌面客户端" as P_CLIENT {
    class CL_ClientApplication as "ClientApplication"
    class CL_LoginFrame as "LoginFrame" {
        - host: String
        - port: int
    }
    class CL_MainFrame as "MainFrame" {
        - session: Session
        - navigationModel: ModuleNavigationModel
        + showModule(module): void
        + logout(): void
    }
    class CL_RegisterDialog as "RegisterDialog"
    class CL_CourseSelectionPanel as "CourseSelectionPanel"
    class CL_CourseManagementPanel as "CourseManagementPanel"
    class CL_StorePanel as "StorePanel"
    class CL_UserManagementPanel as "UserManagementPanel"
    class CL_ModuleNavigationModel as "ModuleNavigationModel"
    class CL_ModuleDescriptor as "ModuleDescriptor"
    class CL_RemoteUserService as "RemoteUserService"
    class CL_RemoteCourseService as "RemoteCourseService"
    class CL_RemoteStoreService as "RemoteStoreService"
    class CL_SocketMessageClient as "SocketMessageClient" {
        - socket: Socket
        - output: ObjectOutputStream
        - input: ObjectInputStream
        + send(request: Message): Message
        + close(): void
    }
    class CL_RequestLifecycle as "RequestLifecycle"

    CL_MainFrame --> CL_ModuleNavigationModel
    CL_ModuleNavigationModel o-- CL_ModuleDescriptor
    CL_MainFrame ..> CL_CourseSelectionPanel
    CL_MainFrame ..> CL_CourseManagementPanel
    CL_MainFrame ..> CL_StorePanel
    CL_MainFrame ..> CL_UserManagementPanel
    CL_RemoteUserService --> CL_SocketMessageClient
    CL_RemoteCourseService --> CL_SocketMessageClient
    CL_RemoteStoreService --> CL_SocketMessageClient
}
