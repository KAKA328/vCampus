' course-selection 模块：课程目录、教学班、轮次、选课记录与维护命令
package "course-selection | 课程与选课" as P_COURSE {
    interface CO_CourseCatalogService as "CourseCatalogService" {
        + create(course): ServiceResult<Course>
        + findById(courseId): ServiceResult<Course>
        + listAll(): ServiceResult<List<Course>>
        + listActive(): ServiceResult<List<Course>>
        + updateDetails(courseId, name, credits): ServiceResult<Course>
        + changeStatus(courseId, status): ServiceResult<Course>
    }
    interface CO_CourseOfferingService as "CourseOfferingService" {
        + create(offering): ServiceResult<CourseOffering>
        + findById(offeringId): ServiceResult<CourseOffering>
        + listByTerm(term): ServiceResult<List<CourseOffering>>
        + changeStatus(offeringId, status): ServiceResult<CourseOffering>
        + changeCapacities(offeringId, ...): ServiceResult<CourseOffering>
        + updateTeachingInfo(offeringId, teacherId, location): ServiceResult<CourseOffering>
    }
    interface CO_CourseSelectionService as "CourseSelectionService" {
        + listAvailableRounds(student, time): ServiceResult<List<SelectionRound>>
        + listAvailableOfferings(student, roundId, time): ServiceResult<List<SelectableCourseOffering>>
        + select(student, roundId, offeringId, time): ServiceResult<CourseSelectionRecord>
        + drop(student, recordId, time): ServiceResult<CourseSelectionRecord>
        + listSelectedOfferings(student): ServiceResult<List<SelectedCourseOffering>>
    }
    interface CO_CourseSelectionRecordService as "CourseSelectionRecordService" {
        + create(record): ServiceResult<CourseSelectionRecord>
        + findById(recordId): ServiceResult<CourseSelectionRecord>
        + listByStudent(studentId): ServiceResult<List<CourseSelectionRecord>>
        + listActiveByOffering(offeringId): ServiceResult<List<CourseSelectionRecord>>
        + markDropped(recordId, time): ServiceResult<CourseSelectionRecord>
    }
    interface CO_CourseOfferingCapacityService as "CourseOfferingCapacityService" {
        + snapshotFor(offeringId): ServiceResult<CourseOfferingCapacitySnapshot>
    }
    interface CO_SelectionRoundService as "SelectionRoundService"
    interface CO_StudentSelectionProfileProvider as "StudentSelectionProfileProvider" {
        + findByUserId(userId): ServiceResult<StudentSelectionProfile>
    }
    interface CO_TrainingPlanService as "TrainingPlanService"
    class CO_DefaultSelectionService as "DefaultCourseSelectionService"
    class CO_InMemoryCourseCatalogService as "InMemoryCourseCatalogService"
    class CO_InMemoryCourseOfferingService as "InMemoryCourseOfferingService"
    class CO_InMemoryRecordService as "InMemoryCourseSelectionRecordService"
    class CO_InMemoryRoundService as "InMemorySelectionRoundService"
    class CO_DefaultCapacityService as "DefaultCourseOfferingCapacityService"
    class CO_CourseSelectionModule as "CourseSelectionModule"
    class CO_Course as "Course" {
        - courseId: String
        - name: String
        - credits: int
        - capacity: int
        - status: CourseStatus
    }
    class CO_CourseOffering as "CourseOffering" {
        - offeringId: String
        - courseId: String
        - term: String
        - teacherId: String
        - schedule: String
        - location: String
        - requiredCapacity: int
        - electiveCapacity: int
        - crossMajorCapacity: int
        - status: CourseOfferingStatus
        - meetingSchedule: CourseSchedule
        + getCapacity(bucket): int
        + getTotalCapacity(): int
    }
    class CO_CourseSchedule as "CourseSchedule"
    class CO_CourseMeeting as "CourseMeeting"
    class CO_SelectionRound as "SelectionRound"
    class CO_CourseSelectionRecord as "CourseSelectionRecord"
    class CO_StudentSelectionProfile as "StudentSelectionProfile"
    class CO_SelectableCourseOffering as "SelectableCourseOffering"
    class CO_SelectedCourseOffering as "SelectedCourseOffering"
    class CO_CapacityBucketUsage as "CapacityBucketUsage"
    class CO_CourseOfferingCapacitySnapshot as "CourseOfferingCapacitySnapshot"
    class CO_ScheduleConflict as "ScheduleConflict"
    class CO_ScheduleConflictDetector as "ScheduleConflictDetector"
    class CO_TrainingPlan as "TrainingPlan"
    class CO_TrainingPlanCourse as "TrainingPlanCourse"
    class CO_CourseManagementCommand as "CourseManagementCommand" {
        - token: String
        - operation: Operation
        - course/offering/targetId: Object
        - teacherId/location: String
        + listCourses(token): CourseManagementCommand
        + createOffering(token, offering): CourseManagementCommand
        + updateTeachingInfo(token, offeringId, teacherId, location): CourseManagementCommand
    }
    class CO_CourseSelectionQueryV2Command as "CourseSelectionQueryV2Command"
    class CO_CourseSelectOfferingV2Command as "CourseSelectOfferingV2Command"
    class CO_CourseDropRecordV2Command as "CourseDropRecordV2Command"
    class CO_CourseQueryCommand as "CourseQueryCommand"
    class CO_CourseSelectionCommand as "CourseSelectionCommand"
    enum CO_CourseStatus as "CourseStatus"
    enum CO_CourseOfferingStatus as "CourseOfferingStatus"
    enum CO_SelectionRoundType as "SelectionRoundType"
    enum CO_SelectionRoundStatus as "SelectionRoundStatus"
    enum CO_SelectionType as "SelectionType"
    enum CO_SelectionRecordStatus as "SelectionRecordStatus"
    enum CO_CapacityBucket as "CapacityBucket"

    CO_CourseCatalogService <|.. CO_InMemoryCourseCatalogService
    CO_CourseOfferingService <|.. CO_InMemoryCourseOfferingService
    CO_CourseSelectionRecordService <|.. CO_InMemoryRecordService
    CO_SelectionRoundService <|.. CO_InMemoryRoundService
    CO_CourseOfferingCapacityService <|.. CO_DefaultCapacityService
    CO_CourseSelectionService <|.. CO_DefaultSelectionService
    CO_CourseSelectionModule *-- CO_CourseSelectionService
    CO_CourseSelectionModule *-- CO_CourseCatalogService
    CO_CourseSelectionModule *-- CO_CourseOfferingService
    CO_DefaultCapacityService --> CO_CourseOfferingService
    CO_DefaultCapacityService --> CO_CourseSelectionRecordService
    CO_DefaultSelectionService --> CO_CourseOfferingService
    CO_DefaultSelectionService --> CO_CourseSelectionRecordService
    CO_DefaultSelectionService --> CO_CourseOfferingCapacityService
    CO_DefaultSelectionService --> CO_StudentSelectionProfileProvider
    CO_DefaultSelectionService --> CO_TrainingPlanService
    CO_DefaultSelectionService --> CO_ScheduleConflictDetector
    CO_CourseOffering --> CO_CourseSchedule
    CO_CourseSchedule o-- CO_CourseMeeting
    CO_CourseOffering --> CO_CourseOfferingStatus
    CO_CourseOffering --> CO_Course
    CO_CourseOfferingCapacitySnapshot *-- CO_CapacityBucketUsage
    CO_CapacityBucketUsage --> CO_CapacityBucket
    CO_CourseSelectionRecord --> CO_SelectionType
    CO_CourseSelectionRecord --> CO_SelectionRecordStatus
    CO_SelectionType --> CO_CapacityBucket
    CO_SelectionRound --> CO_SelectionRoundType
    CO_SelectionRound --> CO_SelectionRoundStatus
    CO_SelectableCourseOffering --> CO_CourseOffering
    CO_SelectableCourseOffering --> CO_Course
    CO_SelectableCourseOffering --> CO_CapacityBucketUsage
    CO_SelectedCourseOffering --> CO_CourseOffering
    CO_SelectedCourseOffering --> CO_CourseSelectionRecord
    CO_TrainingPlan o-- CO_TrainingPlanCourse
    CO_CourseManagementCommand --> CO_Course
    CO_CourseManagementCommand --> CO_CourseOffering
}
