@startuml whole-vCampus-class-diagram

' 维护入口：模块细节位于 docs/uml/，跨模块关系集中在本文件。
' 生成：java -jar plantuml.jar -tsvg docs/whole-vCampus.puml

left to right direction
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 12
skinparam nodesep 20
skinparam ranksep 44
skinparam linetype ortho
hide circle

!include uml/common.puml
!include uml/user-management.puml
!include uml/course-selection.puml
!include uml/student-management.puml
!include uml/library.puml
!include uml/store.puml
!include uml/server.puml
!include uml/client.puml

' =========================== 跨模块关系 ===========================
C_Message --> C_MessageType
C_Message --> C_StatusCode
C_Message ..> C_ServiceResult : response mapping
C_User --> C_Role
C_ServiceResult --> C_StatusCode

S_ServerApplication *-- S_ClientHandler
S_ServerApplication *-- S_UserMessageHandler
S_ServerApplication *-- S_CourseMessageHandler
S_ServerApplication *-- S_StoreMessageHandler
S_ServerApplication ..> S_UserServiceFactory : bootstrap
S_ServerApplication ..> S_StoreServiceFactory : bootstrap
S_UserMessageHandler --> U_UserManagementService
S_CourseMessageHandler --> U_UserManagementService : authorize
S_CourseMessageHandler --> CO_CourseSelectionService
S_CourseMessageHandler --> CO_CourseCatalogService
S_CourseMessageHandler --> CO_CourseOfferingService
S_CourseMessageHandler --> CO_StudentSelectionProfileProvider
S_StoreMessageHandler --> U_UserManagementService : authorize
S_StoreMessageHandler --> ST_StoreService

S_AccessUserRepository ..|> U_UserRepository
S_AccessAuditLogRepository ..|> U_AuditLogRepository
S_AccessPasswordResetRepository ..|> U_PasswordResetRepository
S_AccessProfileBindingRepository ..|> U_ProfileBindingRepository
S_AccessProductRepository ..|> ST_ProductRepository
S_AccessOrderRepository ..|> ST_OrderRepository

CL_ClientApplication ..> CL_LoginFrame : launch
CL_LoginFrame ..> CL_RemoteUserService : login
CL_RegisterDialog ..> CL_RemoteUserService : register
CL_MainFrame ..> CL_RemoteUserService : logout
CL_CourseSelectionPanel ..> CL_RemoteCourseService
CL_CourseManagementPanel ..> CL_RemoteCourseService
CL_StorePanel ..> CL_RemoteStoreService
CL_RemoteUserService --> CL_SocketMessageClient
CL_RemoteCourseService --> CL_SocketMessageClient
CL_RemoteStoreService --> CL_SocketMessageClient
CL_SocketMessageClient --> C_Message : sends

CL_RemoteUserService ..> U_UserCredentials
CL_RemoteUserService ..> U_UserRegistrationCommand
CL_RemoteCourseService ..> CO_CourseManagementCommand
CL_RemoteCourseService ..> CO_CourseSelectionQueryV2Command
CL_RemoteCourseService ..> CO_CourseSelectOfferingV2Command
CL_RemoteCourseService ..> CO_CourseDropRecordV2Command
CL_RemoteStoreService ..> ST_StoreQueryCommand
CL_RemoteStoreService ..> ST_StorePurchaseCommand

U_Session --> C_User
U_UserAccount --> C_User
CO_CourseOffering --> CO_Course
CO_SelectableCourseOffering --> CO_CourseOffering
CO_SelectableCourseOffering --> CO_CapacityBucketUsage
CO_SelectedCourseOffering --> CO_CourseOffering
CO_CourseSelectionRecord --> CO_SelectionType
CO_SelectionType --> CO_CapacityBucket
CO_CourseOfferingCapacitySnapshot *-- CO_CapacityBucketUsage
CO_DefaultSelectionService --> CO_CourseOfferingService
CO_DefaultSelectionService --> CO_CourseSelectionRecordService
CO_DefaultSelectionService --> CO_CourseOfferingCapacityService
CO_DefaultSelectionService --> CO_StudentSelectionProfileProvider
CO_DefaultSelectionService --> CO_TrainingPlanService
CO_DefaultSelectionService --> CO_ScheduleConflictDetector
CO_StudentSelectionProfileProvider ..> STU_StudentRecord : profile bridge
STU_AcademicReviewService --> STU_CourseHistoryRecord
STU_AcademicReviewService ..> STU_AcademicReview : computes
CO_CourseSelectionRecord ..> STU_StudentRecord : studentId

ST_DefaultStoreService --> ST_ProductRepository
ST_DefaultStoreService --> ST_OrderRepository
ST_DefaultStoreService --> ST_CartRepository
ST_Order --> ST_Product : productId snapshot
ST_CartItem --> ST_Product : productId

P_CLIENT -[hidden]down-> P_SERVER
P_SERVER -[hidden]down-> P_USER
P_COURSE -[hidden]right-> P_USER
P_USER -[hidden]right-> P_STORE
P_STORE -[hidden]right-> P_LIBRARY
P_LIBRARY -[hidden]right-> P_STUDENT
P_USER -[hidden]down-> P_COMMON
P_COURSE -[hidden]down-> P_COMMON
P_STORE -[hidden]down-> P_COMMON

@enduml
