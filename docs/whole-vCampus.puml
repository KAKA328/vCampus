@startuml whole-vCampus-class-diagram

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 12

' =====================================================================
' common 模块：通信协议与共享类型
' =====================================================================
package "common 模块（通信协议与共享类型）" {
    class Message <<Envelope>> {
        - requestId: String
        - type: MessageType
        - statusCode: StatusCode
        - sender: String
        - payload: Object
        + {static} request(requestId, type, payload): Message
        + {static} response(request, statusCode, payload): Message
        + withSender(value): Message
    }

    enum MessageType {
        REGISTER / UNREGISTER / LOGIN / LOGOUT
        AUTHORIZE / USER_IMPORT
        STUDENT_QUERY / STUDENT_UPDATE
        COURSE_QUERY / COURSE_SELECT / COURSE_DROP
        COURSE_CREATE / COURSE_UPDATE / COURSE_DEACTIVATE
        LIBRARY_QUERY / LIBRARY_BORROW / LIBRARY_RETURN
        STORE_QUERY / STORE_PURCHASE / STORE_ORDER_QUERY
    }

    enum StatusCode {
        OK
        BAD_REQUEST
        UNAUTHORIZED
        FORBIDDEN
        NOT_FOUND
        CONFLICT
        SERVER_ERROR
    }

    enum Role {
        ADMIN
        STUDENT
        TEACHER
        ACADEMIC_ADMIN
        LIBRARIAN
        STORE_MANAGER
    }

    class "ServiceResult<T>" as ServiceResult <<Generic Result>> {
        - status: StatusCode
        - data: T
        - message: String
        + {static} ok(data): ServiceResult<T>
        + {static} failure(status, message): ServiceResult<T>
    }

    class User <<Value Object>> {
        - userId: String
        - displayName: String
        - role: Role
    }
}

' =====================================================================
' user-management 模块：账号、会话与权限
' =====================================================================
package "user-management 模块" {
    interface UserManagementService {
        + register(credentials: UserCredentials): ServiceResult<Void>
        + importUsers(token, rows): ServiceResult<UserImportResult>
        + unregister(userId, token): ServiceResult<Void>
        + login(credentials): ServiceResult<Session>
        + currentSession(token): ServiceResult<Session>
        + logout(token): ServiceResult<Void>
        + authorize(token, permission): ServiceResult<Boolean>
    }

    class DefaultUserManagementService {
        - users: UserRepository
        - sessions: SessionManager
        - auditLog: AuditLogRepository
        - passwordHasher: PasswordHasher
        - permissionPolicy: RolePermissionPolicy
        + register / importUsers / unregister
        + login / currentSession / logout / authorize
        + provisionAccount(credentials): ServiceResult<Void>
    }

    class InMemoryUserManagementService {
        - delegate: UserManagementService
    }

    interface UserRepository {
        + create(account: UserAccount): boolean
        + findById(userId): UserAccount
        + deactivateById(userId): boolean
    }

    class InMemoryUserRepository {
        - accounts: ConcurrentHashMap<String, UserAccount>
    }

    interface AuditLogRepository {
        + record(event: AuditEvent): void
    }

    class InMemoryAuditLogRepository {
        - events: List<AuditEvent>
    }

    class SessionManager {
        - sessions: ConcurrentHashMap<String, Session>
        - activeTokensByUserId: ConcurrentHashMap<String, String>
        + create(user): Session
        + find(token): Session
        + invalidate(token): boolean
        + invalidateUser(userId): void
    }

    class Session <<Serializable>> {
        - token: String
        - user: User
    }

    class UserAccount <<Entity>> {
        - user: User
        - passwordHash: String
        - active: boolean
        - createdBy: String
        - createdAt: Instant
        - importBatchId: String
        + deactivate(): UserAccount
    }

    class PasswordHasher <<PBKDF2>> {
        + hash(password): String
        + matches(password, encoded): boolean
    }

    class RolePermissionPolicy {
        - matrix: Map<Role, Set<Permission>>
        + isAllowed(role, permission): boolean
    }

    enum Permission {
        USER_SELF_READ / USER_MANAGE
        STUDENT_READ / STUDENT_WRITE
        COURSE_READ / COURSE_SELECT / COURSE_MANAGE
        GRADE_WRITE / ACADEMIC_REVIEW
        LIBRARY_READ / LIBRARY_BORROW / LIBRARY_MANAGE
        STORE_READ / STORE_PURCHASE / STORE_MANAGE
        + fromCode(code): Permission
    }

    class UserCredentials <<Command>> {
        - userId: String
        - password: String
        - displayName: String
        - roleCode: String
    }

    class UserRegistrationCommand <<Command>> {
        - token: String
        - credentials: UserCredentials
    }

    class UserCommand <<Command>> {
        - userId: String
        - token: String
    }

    class AuthorizationRequest <<Command>> {
        - token: String
        - permission: String
    }

    class UserImportCommand <<Command>> {
        - token: String
        - rows: List<UserImportRow>
    }

    class UserImportRow <<Value Object>> {
        - userId: String
        - password: String
        - displayName: String
        - roleCode: String
    }

    class UserImportResult <<Value Object>> {
        - importBatchId: String
        - totalCount: int
        - successCount: int
        - failures: List<UserImportFailure>
    }

    class UserImportFailure <<Value Object>> {
        - rowNumber: int
        - userId: String
        - message: String
    }

    class AuditEvent <<Value Object>> {
        - actorUserId: String
        - action: String
        - targetType: String
        - targetId: String
        - createdAt: Instant
    }
}

' =====================================================================
' student-management 模块：学籍与学业审查
' =====================================================================
package "student-management 模块" {
    interface StudentManagementService {
        + findById(studentId): ServiceResult<StudentRecord>
        + findByClass(classId): ServiceResult<List<StudentRecord>>
        + save(record): ServiceResult<StudentRecord>
    }

    class StudentRecord <<Value Object>> {
        - studentId: String
        - name: String
        - gender: String
        - departmentName: String
        - majorName: String
        - classId: String
        - enrollmentYear: int
        - status: String
        - phone: String
        - email: String
    }

    class InMemoryAcademicReviewService {
        - historiesByStudentId: Map<String, List<CourseHistoryRecord>>
        + addHistory(record): ServiceResult<Void>
        + historyFor(studentId): ServiceResult<List<CourseHistoryRecord>>
        + review(studentId, requiredCredits): ServiceResult<AcademicReview>
    }

    class AcademicReview <<Value Object>> {
        - studentId: String
        - totalEarnedCredits: int
        - passedCourseCount: int
        - failedCourseCount: int
        - retakeCourseCount: int
        - graduationReady: boolean
        - remark: String
    }

    class CourseHistoryRecord <<Value Object>> {
        - studentId: String
        - courseId: String
        - courseName: String
        - semester: String
        - attemptNo: int
        - attemptType: String
        - score: int
        - passed: boolean
        - earnedCredits: int
    }
}

' =====================================================================
' course-selection 模块：课程、教学班与选课轮次
' =====================================================================
package "course-selection 模块" {
    interface CourseSelectionService {
        + listCourses(): ServiceResult<List<Course>>
        + select(studentId, courseId): ServiceResult<Void>
        + drop(studentId, courseId): ServiceResult<Void>
        + selectedCourses(studentId): ServiceResult<List<Course>>
    }

    class InMemoryCourseSelectionService {
        - coursesById: Map<String, Course>
        - courseIdsByStudent: Map<String, Set<String>>
    }

    interface SelectionRoundService {
        + create(round): ServiceResult<SelectionRound>
        + findById(roundId): ServiceResult<SelectionRound>
        + listByTerm(term): ServiceResult<List<SelectionRound>>
        + listOpenRounds(term, time): ServiceResult<List<SelectionRound>>
        + changeStatus(roundId, status): ServiceResult<SelectionRound>
    }

    class InMemorySelectionRoundService {
        - roundsById: Map<String, SelectionRound>
    }

    class Course <<Value Object>> {
        - courseId: String
        - name: String
        - credits: int
        - capacity: int
    }

    class CourseOffering <<Value Object>> {
        - offeringId: String
        - courseId: String
        - term: String
        - teacherId: String
        - schedule: String
        - location: String
        - requiredCapacity: int
        - electiveCapacity: int
        - crossMajorCapacity: int
        - status: CourseOfferingStatus
        + getCapacity(bucket): int
        + getTotalCapacity(): int
    }

    class SelectionRound <<Value Object>> {
        - roundId: String
        - term: String
        - type: SelectionRoundType
        - startsAt: LocalDateTime
        - endsAt: LocalDateTime
        - status: SelectionRoundStatus
        + withStatus(newStatus): SelectionRound
        + isOpenAt(time): boolean
    }

    enum CapacityBucket {
        REQUIRED（必修容量）
        ELECTIVE（选修容量）
        CROSS_MAJOR（跨专业容量）
    }

    enum SelectionType {
        REQUIRED（必修）
        ELECTIVE（选修）
        CROSS_MAJOR（跨专业选修）
        RETAKE（重修）
        + getCapacityBucket(): CapacityBucket
    }

    enum CourseOfferingStatus {
        DRAFT（草稿）
        OPEN（开放选课）
        CLOSED（停止选课）
    }

    enum SelectionRoundType {
        INITIAL（首修轮次）
        RETAKE（重修轮次）
    }

    enum SelectionRoundStatus {
        DRAFT（草稿）
        OPEN（开放）
        CLOSED（关闭）
    }

    class CourseQueryCommand <<Command>> {
        - queryType: QueryType
        - token: String
        - studentId: String
        + {static} allCourses(): CourseQueryCommand
        + {static} selectedCourses(token, studentId): CourseQueryCommand
    }

    class CourseSelectionCommand <<Command>> {
        - token: String
        - studentId: String
        - courseId: String
    }
}

' =====================================================================
' library 模块：图书与借还
' =====================================================================
package "library 模块" {
    interface LibraryService {
        + search(keyword): ServiceResult<List<Book>>
        + borrow(studentId, bookId): ServiceResult<Void>
        + returnBook(studentId, bookId): ServiceResult<Void>
    }

    class Book <<Value Object>> {
        - bookId: String
        - title: String
        - author: String
    }
}

' =====================================================================
' store 模块：商品、订单与购买
' =====================================================================
package "store 模块" {
    interface StoreService {
        + listProducts(): ServiceResult<List<Product>>
        + purchase(userId, productId, quantity): ServiceResult<Void>
        + findOrdersByUserId(userId): ServiceResult<List<Order>>
    }

    class DefaultStoreService {
        - products: ProductRepository
        - orders: OrderRepository
    }

    class InMemoryStoreService {
        - delegate: StoreService
    }

    interface ProductRepository {
        + findAll(): List<Product>
        + findById(id): Product
        + save(product): void
        + updateStock(productId, newStock): boolean
    }

    interface OrderRepository {
        + create(order): boolean
        + findByUserId(userId): List<Order>
    }

    class InMemoryProductRepository {
        - products: ConcurrentHashMap<String, Product>
    }

    class InMemoryOrderRepository {
        - orders: ConcurrentHashMap<String, Order>
        - userIdMap: ConcurrentHashMap<String, List<Order>>
    }

    class Product <<Value Object>> {
        - productId: String
        - name: String
        - stock: int
        - price: double
        - description: String
        - category: String
    }

    class Order <<Value Object>> {
        - orderId: String
        - userId: String
        - productId: String
        - quantity: int
        - totalPrice: double
        - orderDate: LocalDateTime
        - productName: String <<snapshot>>
        - unitPrice: double <<snapshot>>
    }

    class StoreQueryCommand <<Command>> {
        - token: String
    }

    class StorePurchaseCommand <<Command>> {
        - token: String
        - productId: String
        - quantity: int
    }

    class StoreOrderQueryCommand <<Command>> {
        - token: String
    }
}

' =====================================================================
' server 模块：网络入口、消息路由与 Access 持久化
' =====================================================================
package "server 模块" {
    class ServerApplication <<Entry Point>> {
        - port: int
        - userMessages: UserMessageHandler
        - courseMessages: CourseMessageHandler
        - storeMessages: StoreMessageHandler
        - clients: ExecutorService
        - serverSocket: ServerSocket
        + start(): void
        + close(): void
        ~ dispatch(request: Message): Message
        + {static} main(args): void
    }

    class ClientHandler <<inner, Runnable>> {
        - socket: Socket
        + run(): void
    }

    class UserServiceFactory <<Factory>> {
        + {static} create(args): UserManagementService
        + {static} databasePath(args): Path
    }
    note right of UserServiceFactory
        根据 --db 参数选择实现:
        无数据库 → InMemory 仓储 + 演示账号
        有数据库 → Access 仓储
        支持环境变量引导创建管理员
    end note

    class UserMessageHandler {
        - service: UserManagementService
        + handle(request: Message): Message
    }
    note right of UserMessageHandler
        REGISTER / LOGIN / LOGOUT
        UNREGISTER / AUTHORIZE / USER_IMPORT
    end note

    class CourseMessageHandler {
        - courses: CourseSelectionService
        - users: UserManagementService
        + handle(request: Message): Message
    }

    class StoreMessageHandler {
        - store: StoreService
        - users: UserManagementService
        + handle(request: Message): Message
    }
    note right of StoreMessageHandler
        STORE_QUERY → authorize(STORE_READ)
        STORE_PURCHASE → authorize(STORE_PURCHASE)
          + token→Session→userId
        STORE_ORDER_QUERY → authorize(STORE_READ)
          + token→Session→userId
    end note

    class AccessUserRepository {
        - databasePath: Path
    }

    class AccessAuditLogRepository {
        - databasePath: Path
    }

    class AccessCourseSelectionService {
        - databasePath: Path
    }

    class AccessProductRepository {
        - databasePath: Path
    }

    class AccessOrderRepository {
        - databasePath: Path
    }
    note bottom of AccessOrderRepository
        Access 系列仓储通过 JDBC-ODBC
        读写 vCampus.accdb 数据库
    end note
}

' =====================================================================
' client 模块：Swing 界面、远程服务适配与 Socket 传输
' =====================================================================
package "client 模块" {
    class ClientApplication <<Entry Point>> {
        + {static} main(args): void
    }
    note right of ClientApplication
        --demo：对象流协议演示
        默认：启动 Swing 登录窗口
    end note

    package "transport 传输层" {
        class SocketMessageClient <<Closeable>> {
            - socket: Socket
            - output: ObjectOutputStream
            - input: ObjectInputStream
            + send(request: Message): Message
            + close(): void
        }
    }

    package "service 服务适配层" {
        class RemoteUserService <<Closeable>> {
            - messages: SocketMessageClient
            - sequence: AtomicLong
            + register(token, credentials): Message
            + login(credentials): Message
            + logout(token): Message
        }

        class RemoteCourseService <<Closeable>> {
            - messages: SocketMessageClient
            - sequence: AtomicLong
            + listCourses(): Message
            + selectedCourses(token, studentId): Message
            + select(token, studentId, courseId): Message
            + drop(token, studentId, courseId): Message
        }

        class RemoteStoreService <<Closeable>> {
            - messages: SocketMessageClient
            - sequence: AtomicLong
            + listProducts(token): Message
            + purchase(token, productId, quantity): Message
            + ordersFor(token): Message
        }
    }

    package "view 界面层 (Swing)" {
        class LoginFrame <<Swing UI>> {
            - host: String
            - port: int
        }

        class MainFrame <<Swing UI>> {
            - session: Session
            - navigationModel: ModuleNavigationModel
            - content: JPanel
            - navButtons: Map<String, JButton>
            - showHome(): void
            - showModule(module): void
            - logout(): void
        }

        class RegisterDialog <<Swing UI>> {
            - session: Session
        }

        class CourseSelectionPanel <<Swing UI>> {
            - session: Session
            课程查询 + 选课/退选
        }

        class StorePanel <<Swing UI>> {
            - session: Session
            商品列表 + 购买 + 订单查询
        }

        class ModuleNavigationModel {
            + visibleModules(role): List<String>
            + visibleModuleCards(role): List<ModuleDescriptor>
        }

        class ModuleDescriptor <<Value Object>> {
            - title: String
            - summary: String
            - status: String
        }

        class ModuleCardPanel <<Swing UI>>
        class ResponsiveModuleGridPanel <<Swing UI>>
        class VCampusTheme <<Style>>
        class PromptTextField <<Swing UI>>
        class PromptPasswordField <<Swing UI>>
        class BatchTableModel <<Table Model>>
    }
}

' =====================================================================
' 关系：common 内部
' =====================================================================
Message --> MessageType
Message --> StatusCode
User --> Role
ServiceResult --> StatusCode

' =====================================================================
' 关系：user-management 模块内部
' =====================================================================
UserManagementService <|.. DefaultUserManagementService
UserManagementService <|.. InMemoryUserManagementService
InMemoryUserManagementService *-- DefaultUserManagementService : delegates

DefaultUserManagementService --> UserRepository
DefaultUserManagementService --> SessionManager
DefaultUserManagementService --> AuditLogRepository
DefaultUserManagementService *-- PasswordHasher
DefaultUserManagementService *-- RolePermissionPolicy
DefaultUserManagementService ..> UserCredentials : validates
DefaultUserManagementService ..> UserAccount : creates
DefaultUserManagementService ..> AuditEvent : records

UserRepository <|.. InMemoryUserRepository
AuditLogRepository <|.. InMemoryAuditLogRepository

SessionManager o-- Session : creates
Session --> User
UserAccount --> User
RolePermissionPolicy ..> Permission : matrix
UserRegistrationCommand --> UserCredentials
UserImportCommand o-- UserImportRow
UserImportResult o-- UserImportFailure

' =====================================================================
' 关系：student-management 模块内部
' =====================================================================
StudentManagementService ..> StudentRecord
InMemoryAcademicReviewService o-- CourseHistoryRecord
InMemoryAcademicReviewService ..> AcademicReview : computes

' =====================================================================
' 关系：course-selection 模块内部
' =====================================================================
CourseSelectionService <|.. InMemoryCourseSelectionService
SelectionRoundService <|.. InMemorySelectionRoundService
InMemoryCourseSelectionService o-- Course
InMemorySelectionRoundService o-- SelectionRound

CourseOffering --> CourseOfferingStatus
CourseOffering ..> CapacityBucket
CourseOffering ..> Course : courseId
SelectionRound --> SelectionRoundType
SelectionRound --> SelectionRoundStatus
SelectionType ..> CapacityBucket : occupies

' =====================================================================
' 关系：store 模块内部
' =====================================================================
StoreService <|.. DefaultStoreService
StoreService <|.. InMemoryStoreService
InMemoryStoreService *-- DefaultStoreService : delegates

ProductRepository <|.. InMemoryProductRepository
OrderRepository <|.. InMemoryOrderRepository

DefaultStoreService --> ProductRepository
DefaultStoreService --> OrderRepository

' =====================================================================
' 关系：server 模块
' =====================================================================
ServerApplication *-- ClientHandler
ServerApplication --> UserMessageHandler
ServerApplication --> CourseMessageHandler
ServerApplication --> StoreMessageHandler
ServerApplication ..> UserServiceFactory : bootstraps

UserMessageHandler --> UserManagementService
CourseMessageHandler --> CourseSelectionService
CourseMessageHandler --> UserManagementService
StoreMessageHandler --> StoreService
StoreMessageHandler --> UserManagementService

UserServiceFactory ..> DefaultUserManagementService : creates
UserServiceFactory ..> SessionManager : creates

UserRepository <|.. AccessUserRepository
AuditLogRepository <|.. AccessAuditLogRepository
CourseSelectionService <|.. AccessCourseSelectionService
ProductRepository <|.. AccessProductRepository
OrderRepository <|.. AccessOrderRepository

' =====================================================================
' 关系：client 模块
' =====================================================================
ClientApplication ..> LoginFrame : launches

RemoteUserService --> SocketMessageClient
RemoteCourseService --> SocketMessageClient
RemoteStoreService --> SocketMessageClient

RemoteUserService ..> UserRegistrationCommand : creates
RemoteCourseService ..> CourseQueryCommand : creates
RemoteCourseService ..> CourseSelectionCommand : creates
RemoteStoreService ..> StoreQueryCommand : creates
RemoteStoreService ..> StorePurchaseCommand : creates
RemoteStoreService ..> StoreOrderQueryCommand : creates

LoginFrame ..> RemoteUserService : uses
LoginFrame ..> MainFrame : opens after login
LoginFrame --> PromptTextField
LoginFrame --> PromptPasswordField
LoginFrame ..> VCampusTheme

MainFrame --> ModuleNavigationModel
MainFrame --> Session
MainFrame ..> CourseSelectionPanel : creates
MainFrame ..> StorePanel : creates
MainFrame ..> RegisterDialog : creates
MainFrame ..> ModuleCardPanel : creates
MainFrame ..> ResponsiveModuleGridPanel : creates
MainFrame ..> RemoteUserService : logout
ModuleNavigationModel o-- ModuleDescriptor
ModuleCardPanel --> ModuleDescriptor

CourseSelectionPanel ..> RemoteCourseService : uses
StorePanel ..> RemoteStoreService : uses
RegisterDialog ..> RemoteUserService : uses

' =====================================================================
' 跨模块：客户端与服务端通过 Message 通信
' =====================================================================
SocketMessageClient ..> Message : sends/receives
UserMessageHandler ..> Message
CourseMessageHandler ..> Message
StoreMessageHandler ..> Message

@enduml
