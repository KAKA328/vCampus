@startuml store-module-class-diagram

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 12

package "store 模块" {
    interface StoreService {
        + listProducts(): ServiceResult<List<Product>>
        + purchase(userId: String, productId: String, quantity: int): ServiceResult<Void>
        + findOrdersByUserId(userId: String): ServiceResult<List<Order>>
        + restock(userId, productId, additionalStock): ServiceResult<Void>
        + addProduct(name, price, stock, description, category): ServiceResult<Product>
        + updateProduct(productId, name, price, description, category): ServiceResult<Product>
        + deactivateProduct(userId, productId): ServiceResult<Void>
        + addToCart(userId, productId, quantity): ServiceResult<Void>
        + removeFromCart(userId, cartItemId): ServiceResult<Void>
        + getCart(userId): ServiceResult<List<CartItem>>
        + checkout(userId): ServiceResult<Void>
        + findAllOrders(): ServiceResult<List<Order>>
        + listHotProducts(limit): ServiceResult<List<Product>>
        + listProducts(category): ServiceResult<List<Product>>
    }

    class DefaultStoreService {
        - products: ProductRepository
        - orders: OrderRepository
        - cart: CartRepository <<可为 null>>
        + listProducts(): ServiceResult<List<Product>> <<只返回上架商品>>
        + purchase(userId, productId, quantity): ServiceResult<Void>
        + findOrdersByUserId(userId): ServiceResult<List<Order>>
        + restock / addProduct / updateProduct / deactivateProduct
        + addToCart / removeFromCart / getCart / checkout
        + findAllOrders / listHotProducts / listProducts(category)（占位）
    }
    note bottom of DefaultStoreService
        2 参构造函数委托 3 参版本，购物车传 null（向后兼容），
        此时购物车方法统一返回 BAD_REQUEST；
        checkout 采用两段式：tryBuy 全部预检通过后才逐项 purchase 并清空购物车
    end note

    class InMemoryStoreService {
        - delegate: StoreService
        + InMemoryStoreService()（自带三仓库）
        + InMemoryStoreService(products, orders)
        + InMemoryStoreService(products, orders, cart)（包内，测试注入）
        + 全部 StoreService 方法（原样转发给 delegate）
    }

    interface ProductRepository {
        + findAll(): List<Product>
        + findById(id: String): Product
        + save(product: Product): void
        + updateStock(productId: String, newStock: int): boolean
        + addStock(productId: String, amount: int): boolean
        + updateProduct(product: Product): boolean
        + deleteById(productId: String): boolean
    }

    interface OrderRepository {
        + create(order: Order): boolean
        + findByUserId(userId: String): List<Order>
        + findAll(): List<Order>
        + findSalesVolume(): List<Map.Entry<String, Integer>>
    }

    interface CartRepository {
        + findByUserId(userId: String): List<CartItem>
        + addItem(item: CartItem): boolean
        + removeItem(cartItemId: String): boolean
        + updateQuantity(cartItemId: String, newQuantity: int): boolean
        + clearByUserId(userId: String): void
    }

    class InMemoryProductRepository {
        - products: ConcurrentHashMap<String, Product>
        + findAll(): List<Product>
        + findById(id): Product
        + save(product): void
        + updateStock(productId, newStock): boolean
        + addStock(productId, amount): boolean
        + updateProduct(product): boolean
        + deleteById(productId): boolean
    }

    class InMemoryOrderRepository {
        - orders: ConcurrentHashMap<String, Order>
        - userIdMap: ConcurrentHashMap<String, List<Order>>
        + create(order): boolean
        + findByUserId(userId): List<Order>
        + findAll(): List<Order>
        + findSalesVolume(): List<Map.Entry<String, Integer>> <<不可变快照，可序列化>>
    }

    class InMemoryCartRepository {
        - items: ConcurrentHashMap<String, CartItem>
        - userIdMap: ConcurrentHashMap<String, List<CartItem>>
        + findByUserId(userId): List<CartItem> <<返回副本>>
        + addItem(item): boolean <<同商品数量累加>>
        + removeItem(cartItemId): boolean
        + updateQuantity(cartItemId, newQuantity): boolean
        + clearByUserId(userId): void
    }

    class Product <<Value Object>> {
        - productId: String
        - name: String
        - stock: int
        - price: double
        - description: String
        - category: String
        - active: boolean
    }

    class Order <<Value Object>> {
        - orderId: String
        - userId: String
        - productId: String
        - quantity: int
        - totalPrice: double
        - orderDate: LocalDateTime
        - productName: String <<snapshot>>
        - unitPrice: double <<snapshot>>
    }

    class StoreQueryCommand <<Command>> {
        - token: String
        - category: String <<null 表示查全部分类>>
        + getToken(): String
        + getCategory(): String
    }

    class StorePurchaseCommand <<Command>> {
        - token: String
        - productId: String
        - quantity: int
        + getToken(): String
        + getProductId(): String
        + getQuantity(): int
    }

    class StoreOrderQueryCommand <<Command>> {
        - token: String
        + getToken(): String
    }

    class StoreRestockCommand <<Command>> {
        - token: String
        - productId: String
        - additionalStock: int
    }

    class StoreProductAddCommand <<Command>> {
        - token: String
        - name: String
        - price: double
        - stock: int
        - description: String
        - category: String
    }

    class StoreProductUpdateCommand <<Command>> {
        - token: String
        - productId: String
        - name: String
        - price: double
        - description: String
        - category: String
    }

    class StoreProductDeactivateCommand <<Command>> {
        - token: String
        - productId: String
    }

    class CartAddCommand <<Command>> {
        - token: String
        - productId: String
        - quantity: int
    }

    class CartRemoveCommand <<Command>> {
        - token: String
        - cartItemId: String
    }

    class CartQueryCommand <<Command>> {
        - token: String
    }

    class CartCheckoutCommand <<Command>> {
        - token: String
    }

    class StoreOrderListAllCommand <<Command>> {
        - token: String
    }

    class StoreHotProductsCommand <<Command>> {
        - token: String
        - limit: int
    }

    class CartItem <<Value Object>> {
        - cartItemId: String
        - userId: String
        - productId: String
        - quantity: int
        - addedAt: LocalDateTime
    }
}

package "server 模块" {
    class StoreMessageHandler {
        - store: StoreService
        - users: UserManagementService
        + handle(request: Message): Message
    }
    note right of StoreMessageHandler
        三种消息处理:
        STORE_QUERY → authorize(STORE_READ)
        STORE_PURCHASE → authorize(STORE_PURCHASE)
          + token→Session→userId
        STORE_ORDER_QUERY → authorize(STORE_READ)
          + token→Session→userId
    end note
}

package "client 模块" {
    class RemoteStoreService {
        - messages: SocketMessageClient
        - sequence: AtomicLong
        + listProducts(token): Message
        + purchase(token, productId, quantity): Message
        + ordersFor(token): Message
        + close(): void
    }

    class StorePanel <<Swing UI>> {
        商品列表 + 购买 + 订单查询
    }
}

StoreService <|.. DefaultStoreService
StoreService <|.. InMemoryStoreService
InMemoryStoreService *-- DefaultStoreService : delegates

ProductRepository <|.. InMemoryProductRepository
OrderRepository <|.. InMemoryOrderRepository
CartRepository <|.. InMemoryCartRepository

CartRepository ..> CartItem : stores

DefaultStoreService --> ProductRepository
DefaultStoreService --> OrderRepository
DefaultStoreService --> CartRepository

StoreMessageHandler --> StoreService
StoreMessageHandler --> UserManagementService

RemoteStoreService ..> StoreQueryCommand : creates
RemoteStoreService ..> StorePurchaseCommand : creates
RemoteStoreService ..> StoreOrderQueryCommand : creates

@enduml
